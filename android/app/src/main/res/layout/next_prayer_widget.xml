<?xml version="1.0" encoding="utf-8"?>
<!-- Rectangular home-screen widget, locked to the 300x130dp size and
     96dp-motif-panel + text-panel split from DESIGN_RULES.md — diffed
     directly against Prayer & Qibla App.dc.html lines 333-351. Do not
     resize or add padding around a single box; the two-panel split is the
     whole point. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="300dp"
    android:layout_height="130dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Motif/compass panel: fixed 96dp, never resizes with the card. -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_left_panel_bg">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/widget_compass_ring" />

            <ImageView
                android:id="@+id/widget_compass_needle"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/widget_compass_needle" />

            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/widget_star_motif" />
        </FrameLayout>

        <!-- Text panel: next prayer name+time, minutes remaining, Hijri
             date — never the city/location (DESIGN_RULES.md line 48). -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/widget_header"
                android:fontFamily="@font/figtree_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="@string/widget_default_header"
                android:textAllCaps="true"
                android:textColor="#A85A2A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_prayer_name"
                android:fontFamily="@font/caprasimo_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_default_prayer"
                android:textColor="#201E1D"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/widget_countdown"
                android:fontFamily="@font/figtree_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#7A4019"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_hijri"
                android:alpha="0.7"
                android:fontFamily="@font/figtree_regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#201E1D"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
